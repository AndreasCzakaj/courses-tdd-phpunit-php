<?xml version="1.0"?>
<ruleset name="tdd-phpunit-php">
    <description>Coding standard: PSR-12 plus a limit for the cyclomatic complexity (CCN)</description>

    <file>src</file>
    <file>tests</file>
    <file>bin</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- test names like `shouldBe_1990_05_15` are fine -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- metric: break the build for methods with a CCN above 5 -->
    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="5"/>
            <property name="absoluteComplexity" value="5"/>
        </properties>
    </rule>
</ruleset>
